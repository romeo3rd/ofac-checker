# Copy this file to a private environment file on the server.
# Never commit real passwords, hashes, or session secrets.

# Generate a session secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OFAC_SESSION_SECRET=replace-with-a-long-random-secret

# Generate password hashes:
# python scripts/hash_password.py
#
OFAC_PASSWORD_HASH=replace-with-password-hash

# Set true when the site is served over HTTPS.
OFAC_COOKIE_SECURE=false

# 12 hours by default.
OFAC_SESSION_TTL_SECONDS=43200
